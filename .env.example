# Optional: LLM drafting (falls back to template drafts if unset)
OPENAI_API_KEY=
SMM_OPENAI_MODEL=gpt-4o-mini

# GitHub OAuth app settings (create at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# `repo` enables private repository reads; omit it for public repositories only.
GITHUB_OAUTH_SCOPE=read:user repo

# Optional overrides
# SMM_DATA_DIR=~/.smm
# SMM_CONSENT_TTL_DAYS=90
# SMM_AUTO_MAX_PER_DAY=1
# SMM_BLOCKLIST=salary,confidential,secret,api key,password
# WEB_ORIGIN=http://localhost:3000
# Set SMM_COOKIE_SECURE=true when both API and web app are served over HTTPS.
