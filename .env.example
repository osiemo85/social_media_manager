# Optional: LLM drafting (falls back to template drafts if unset)
OPENAI_API_KEY=
SMM_OPENAI_MODEL=gpt-4o-mini

# GitHub OAuth app settings (create at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# `repo` enables private repository reads; omit it for public repositories only.
GITHUB_OAUTH_SCOPE=read:user repo

# Google source OAuth. Enable Gmail API and Google Drive API in this project,
# then register: http://localhost:3000/api/connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Restricted Google scopes are disabled until explicitly enabled.
SMM_GOOGLE_SOURCES_ENABLED=false
# SMM_GOOGLE_HTTP_TIMEOUT_SECONDS=20
# SMM_GOOGLE_MAX_DOWNLOAD_BYTES=5242880

# Optional overrides
# SMM_DATA_DIR=~/.smm
# SMM_CONSENT_TTL_DAYS=90
# SMM_AUTO_MAX_PER_DAY=1
# SMM_BLOCKLIST=salary,confidential,secret,api key,password
# WEB_ORIGIN=http://localhost:3000
# Set SMM_COOKIE_SECURE=true when both API and web app are served over HTTPS.
